from kivy.app import App
from kivy.lang import Builder
from kivy.uix.screenmanager import ScreenManager, Screen
from bs4 import BeautifulSoup
from nltk.sentiment import SentimentIntensityAnalyzer
import requests, nltk, datetime

nltk.download('vader_lexicon')

KV = '''
ScreenManager:
    HomeScreen:

<HomeScreen>:
    name: 'home'
    canvas.before:
        Color:
            rgba: 0, 0, 0, 1
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        padding: dp(20)
        spacing: dp(20)

        Image:
            source: 'assets/logo.png'
            size_hint: None, None
            size: dp(150), dp(150)
            pos_hint: {'center_x': .5}

        Label:
            id: price_label
            text: 'در حال دریافت قیمت...'
            font_size: '24sp'
            color: 1, 0.84, 0, 1

        Label:
            id: pred_label
            text: ''
            font_size: '20sp'
            color: 1, 1, 1, 1

        Button:
            text: 'به‌روزرسانی پیش‌بینی'
            size_hint_y: None
            height: dp(50)
            background_color: 1, 0.84, 0, 1
            color: 0, 0, 0, 1
            on_release: app.update_prediction()
'''
class HomeScreen(Screen): pass

class GoldApp(App):
    def build(self):
        return Builder.load_string(KV)

    def fetch_price(self):
        try:
            r = requests.get('https://www.tgju.org/profile/geram18', headers={'User-Agent':'Mozilla/5.0'}, timeout=5)
            soup = BeautifulSoup(r.text, 'html.parser')
            tag = soup.find('span', id='last_top') or soup.find('span', id='last_current')
            return int(tag.text.replace(',', ''))
        except:
            return None

    def fetch_comments(self):
        comments=[]
        try:
            r = requests.get('https://www.servatmandi.com/gold', headers={'User-Agent':'Mozilla/5.0'}, timeout=5)
            soup = BeautifulSoup(r.text, 'html.parser')
            for t in soup.find_all('div', class_='comment-body'):
                txt = t.get_text(strip=True)
                if txt: comments.append(txt)
        except:
            pass
        return comments

    def update_prediction(self):
        price = self.fetch_price()
        screen = self.root.get_screen('home')
        if price is None:
            screen.ids.price_label.text = '⚠️ خطا در دریافت قیمت'
            return
        screen.ids.price_label.text = f'قیمت فعلی: {price:,} تومان'
        sia = SentimentIntensityAnalyzer()
        user_s = sum(sia.polarity_scores(t)['compound'] for t in self.fetch_comments()) / max(len(self.fetch_comments()),1)
        pred = int(price * (1 + user_s * 0.05))
        screen.ids.pred_label.text = f'پیش‌بینی فردا: {pred:,} تومان'

if __name__ == '__main__':
    GoldApp().run()

