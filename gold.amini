[app]
title = Gold Predictor Pro
package.name = goldpredictorpro
package.domain = org.example
source.dir = .
icon.filename = assets/logo.png
version = 1.0
requirements = python3,kivy,requests,beautifulsoup4,nltk
orientation = portrait
fullscreen = 0
name: Build APK

on:
  push:
    branches: [ main ]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repo
        uses: actions/checkout@v3

      - name: Set up Python & Install Buildozer
        run: |
          sudo apt update
          sudo apt install -y python3-pip git zip unzip openjdk-8-jdk
          pip3 install --upgrade pip
          pip3 install buildozer

      - name: Build APK
        working-directory: ${{ github.workspace }}
        run: buildozer android debug

      - name: Upload APK Artifact
        uses: actions/upload-artifact@v3
        with:
          name: GoldPredictorPro-APK
          path: bin/*.apk
